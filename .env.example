# ============================================
# SIPEDAS — Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya

# Domain produksi (tanpa https://). Contoh: sipedas.bpskabtasi.go.id
# Jika kosong, server jalan dalam mode development (localhost)
SIPEDAS_DOMAIN=

# Database MySQL — WAJIB diisi untuk production
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://sipedas:password_anda@localhost:3306/bps_tasikmalaya

# Password admin — WAJIB diisi untuk production
# Akan di-hash dan disimpan ke data/auth_credentials.json pada startup pertama
SIPEDAS_ADMIN_PASSWORD=
